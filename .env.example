# ─────────────────────────────────────────────────────────────────────────────
# V_ICT_ORIOUS Live Club : variables d'environnement
# Copie ce fichier en .env (jamais committé) et remplis les valeurs.
# Aucun secret ne doit être collé ailleurs (chat, code, captures d'écran).
# Les tarifs, durées, délai de grâce et rappels sont dans packages/core/src/config/club.ts
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
# URL publique du site (sans / final). En production : https://ton-domaine
APP_URL=http://localhost:3000

# Postgres (local : docker compose up -d db)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/victorious

# Secret de signature des sessions et des liens de renouvellement (64 caractères aléatoires).
# Générer : openssl rand -base64 48
SESSION_SECRET=

# ── Discord (portail développeur : https://discord.com/developers/applications) ──
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# IDs (mode développeur Discord → clic droit → « Copier l'identifiant »)
DISCORD_GUILD_ID=
# Rôle donné aux abonnés : par ID, jamais par nom
DISCORD_MEMBER_ROLE_ID=
# Rôle autorisé à utiliser /abonne /ajouter /retirer /expirations /stats
DISCORD_ADMIN_ROLE_ID=
# Salon privé où le bot poste les événements
DISCORD_LOG_CHANNEL_ID=
# Exceptions de la réconciliation (jamais retirées) : IDs séparés par des virgules
DISCORD_EXEMPT_USER_IDS=
DISCORD_EXEMPT_ROLE_IDS=
DISCORD_INVITE_URL=https://discord.gg/SMFqgxbb6
# À l'expiration : remove_role (défaut, le membre reste sur le serveur) ou kick (nécessite « Expulser des membres »)
EXPIRY_ACTION=remove_role

# Lien d'invitation du Telegram privé (montré uniquement aux membres actifs)
TELEGRAM_INVITE_URL=

# ── Paiements ──
# Prestataire par moyen de paiement : flutterwave | wave | none
PAYMENT_PROVIDER_CARD=flutterwave
PAYMENT_PROVIDER_MOBILE_MONEY=flutterwave

# Flutterwave (dashboard → Settings → API keys ; Webhooks → Secret hash)
FLW_SECRET_KEY=
FLW_WEBHOOK_HASH=
FLW_API_BASE_URL=https://api.flutterwave.com
FLW_MOBILE_MONEY_OPTION=mobilemoneyfranco
# Plans récurrents (renouvellement automatique par carte) : pnpm flw:create-plans --apply
FLW_PLAN_ID_MONTHLY=
FLW_PLAN_ID_QUARTERLY=
FLW_PLAN_ID_ANNUAL=

# Wave Business (portail Wave Business → Développeurs ; webhook en mode « Signing secret »)
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=
WAVE_API_BASE_URL=https://api.wave.com

# ── Emails ──
# console (affiche les emails dans les logs) ou resend
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=V_ICT_ORIOUS Live Club <club@ton-domaine>
EMAIL_REPLY_TO=

# ── Développement local sans compte marchand ──
# pnpm mock:providers puis :
#   FLW_SECRET_KEY=FLWSECK_TEST-mock  FLW_WEBHOOK_HASH=flw-webhook-hash-dev  FLW_API_BASE_URL=http://127.0.0.1:4010
#   WAVE_API_KEY=wave_sn_test_mock    WAVE_WEBHOOK_SECRET=wave_sn_WHS_dev     WAVE_API_BASE_URL=http://127.0.0.1:4010
#   FLW_PLAN_ID_MONTHLY=111 FLW_PLAN_ID_QUARTERLY=222 FLW_PLAN_ID_ANNUAL=333
# Tests : TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

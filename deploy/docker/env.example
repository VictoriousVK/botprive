# Copier en .env à la racine (jamais commité). Tous les secrets se génèrent, par exemple :
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
DOMAIN=app.votre-domaine.com
HF_PUBLIC_HOST=app.votre-domaine.com
HF_PUBLIC_URL=https://app.votre-domaine.com
HF_COOKIE_SECURE=1

POSTGRES_ADMIN_PASSWORD=
APP_DB_PASSWORD=

# Tâches planifiées (n8n → /api/jobs/*)
HF_JOBS_SECRET=

# Chiffrement des mots de passe investisseur (Fernet) :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
HF_SECRET_KEY=

# Modèles (sans clé : revues et analyses par les règles, sans narration IA)
ANTHROPIC_API_KEY=

# Prix : "simulation" sur un serveur Linux ; le flux MT5 réel vient du VPS Windows.
HF_FEED=simulation

# Telegram (facultatif)
HF_TELEGRAM_BOT_TOKEN=
HF_TELEGRAM_BOT_NAME=
HF_TELEGRAM_WEBHOOK_SECRET=

# Compilation MQL5 (usine EA) sur le VPS Windows (facultatif)
HF_MQL_COMPILER_URL=
HF_MQL_COMPILER_TOKEN=

# Sources de données (facultatif, licences à vérifier)
HF_CALENDAR_URL=
HF_NEWS_FEEDS=

{
  "name": "@vk/worker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup",
    "register-commands": "tsx --env-file-if-exists=../../.env src/register-commands.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@vk/core": "workspace:*",
    "@vk/db": "workspace:*",
    "discord.js": "14.27.0",
    "drizzle-orm": "0.45.4",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
